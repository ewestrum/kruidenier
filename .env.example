# Kopieer naar .env (alleen op de NAS / lokaal, nooit in git) en zet rechten op 600.

TZ=Europe/Amsterdam

# Image en versie. Pin in productie een versie, bijv. TAG=0.1.0 (niet latest).
IMAGE=ghcr.io/OWNER/kruidenier
TAG=latest

# Map op de NAS voor database en backups (wordt door Hyper Backup meegenomen)
DATA_DIR=/volume1/docker/kruidenier
WEB_PORT=8085

# Database. DATABASE_URL wordt in docker-compose.yml samengesteld uit dit wachtwoord.
POSTGRES_PASSWORD=
# Alleen nodig buiten Docker (lokaal ontwikkelen tegen de dev-database):
# DATABASE_URL=postgresql+psycopg://kruidenier:<wachtwoord>@localhost:5432/kruidenier

# Sessies (web-UI). Genereer met:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Versleuteling AH-tokens. Kwijt = AH-accounts opnieuw koppelen. Genereer met:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Bijv. https://kruidenier.<jouwdomein> (voor links in notificaties)
BASE_URL=

# Notificaties (optioneel): Home Assistant-webhook, ntfy als fallback
HA_WEBHOOK_URL=
NTFY_URL=

# Backups
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14

# AH-adapter (alleen aanpassen als de app-identiteit verandert, zie docs/ah-api.md)
AH_CLIENT_ID=appie-ios
AH_CLIENT_VERSION=9.28
AH_MIN_REQUEST_INTERVAL=1.0
